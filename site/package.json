{
  "name": "waktu-sholat-site",
  "private": true,
  "description": "Landing page for Waktu Sholat. Static; public/ is the deploy root.",
  "scripts": {
    "build": "tailwindcss -i ./src/app.css -o ./public/assets/app.css --minify && node scripts/build.mjs",
    "dev": "node scripts/build.mjs && tailwindcss -i ./src/app.css -o ./public/assets/app.css --watch",
    "preview": "npm run build && node scripts/serve.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0"
  }
}
