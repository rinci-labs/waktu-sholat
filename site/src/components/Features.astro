---
// Each claim beside the screen that shows it, on a panel tinted with one of the app's skies:
// midday for the home screen, night for the Qibla compass, afternoon for the widgets.
import { t, type Lang } from "../i18n";
import { SKY } from "../lib/day";
import Icon from "./Icon.astro";

interface Props {
  lang: Lang;
}
const s = t(Astro.props.lang);
const sky = (p: keyof typeof SKY) => `background:linear-gradient(165deg,${SKY[p][0]},${SKY[p][1]})`;
---

<section id="fitur" class="mx-auto max-w-6xl px-5 py-28 sm:px-8" aria-labelledby="features-title">
  <h2 id="features-title" class="max-w-2xl text-3xl font-bold tracking-[-0.02em] text-balance sm:text-4xl">{s.featuresTitle}</h2>

  {/* Home screen: the widest panel, both themes side by side, cropped by the panel's bottom edge. */}
  <article class="relative mt-12 grid overflow-hidden rounded-[2rem] text-white lg:grid-cols-[1fr_1.05fr]" style={sky("siang")}>
    <div class="p-8 sm:p-12 lg:py-16">
      <h3 class="text-2xl font-bold tracking-[-0.01em] sm:text-3xl">{s.f1Title}</h3>
      <p class="mt-4 max-w-md text-lg leading-relaxed text-white/85">{s.f1Body}</p>
      <ul class="mt-7 space-y-3 text-white/90">
        {s.f1Points.map((p) => <li class="flex gap-3"><Icon name="check" class="mt-1 size-4 shrink-0" /><span>{p}</span></li>)}
      </ul>
    </div>
    {/* Phones: one centred screen, cropped by the panel edge. Wider: the dark theme tucked behind it. */}
    <div class="relative h-[400px] sm:h-[460px] lg:h-auto lg:min-h-[580px]">
      <div class="phone absolute top-6 left-[74%] hidden w-[42%] max-w-[230px] -translate-x-1/2 sm:block lg:top-24">
        <img src="/screens/today-dark.webp" width="540" height="1205" loading="lazy" decoding="async" alt={s.altDark} />
      </div>
      <div class="phone absolute top-0 left-1/2 z-10 w-[66%] max-w-[270px] -translate-x-1/2 sm:left-[40%] sm:w-[48%] lg:top-12">
        <img src="/screens/today.webp" width="540" height="1205" loading="lazy" decoding="async" alt={s.altLight} />
      </div>
    </div>
  </article>

  <div class="mt-6 grid gap-6 lg:grid-cols-2">
    <article class="flex flex-col overflow-hidden rounded-[2rem] text-white" style={sky("malam")}>
      <div class="p-8 sm:p-10">
        <h3 class="text-2xl font-bold tracking-[-0.01em]">{s.f2Title}</h3>
        <p class="mt-3 leading-relaxed text-white/80">{s.f2Body}</p>
        <ul class="mt-5 space-y-2.5 text-white/85">
          {s.f2Points.map((p) => <li class="flex gap-3"><Icon name="check" class="mt-1 size-4 shrink-0" /><span>{p}</span></li>)}
        </ul>
      </div>
      <div class="mt-auto flex h-[300px] justify-center overflow-hidden sm:h-[340px]">
        <div class="phone w-[62%] max-w-[270px] self-start">
          <img src="/screens/qibla.webp" width="540" height="1205" loading="lazy" decoding="async" alt={s.altQibla} />
        </div>
      </div>
    </article>

    <article class="flex flex-col overflow-hidden rounded-[2rem] text-white" style={sky("sore")}>
      <div class="p-8 sm:p-10">
        <h3 class="text-2xl font-bold tracking-[-0.01em]">{s.f3Title}</h3>
        <p class="mt-3 leading-relaxed text-white/85">{s.f3Body}</p>
        <p class="mt-3 leading-relaxed text-white/85">{s.f3Body2}</p>
      </div>
      <div class="mt-auto px-8 pb-8 sm:px-10 sm:pb-10">
        <div class="phone rounded-[1.9rem]!">
          <img src="/screens/widgets.webp" width="720" height="562" loading="lazy" decoding="async" class="rounded-[1.5rem]!" alt={s.altWidgets} />
        </div>
      </div>
    </article>
  </div>
</section>
