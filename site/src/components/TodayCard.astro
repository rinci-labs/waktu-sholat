---
// Today's schedule in the hero, for Jakarta until the visitor picks a place. Rendered with the build
// day's numbers, then kept current by scripts/live.ts (same formula as the app, in the browser).
import { t, type Lang } from "../i18n";
import { fmt, P } from "../lib/prayer";
import { JAKARTA, nextPrayer, type Day } from "../lib/day";
import Icon from "./Icon.astro";
import PlacePicker from "./PlacePicker.astro";

interface Props {
  lang: Lang;
  day: Day;
}
const { lang, day } = Astro.props;
const s = t(lang);
const next = nextPrayer(day);
const date = `${s.weekdays[day.weekday]}, ${day.day} ${s.months[day.month - 1]} ${day.year}`;
const state = (i: number) => (i === next.index ? "next" : day.times[i]! <= day.minute ? "past" : "later");
---

<section class="glass rise rounded-[1.75rem] p-5 text-white sm:p-6" style="--rise:.15s" aria-labelledby="today-title" data-today>
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0">
      <h2 id="today-title" class="font-semibold">{s.todayTitle}</h2>
      <p class="mt-0.5 text-sm text-white/70" data-date>{date}</p>
    </div>
    <button
      type="button"
      class="inline-flex max-w-[55%] shrink-0 items-center gap-1.5 rounded-full bg-white/12 py-1.5 pr-3 pl-2.5 text-sm font-medium ring-1 ring-white/15 transition-colors hover:bg-white/20"
      aria-haspopup="dialog"
      data-place-open
    >
      <Icon name="pin" class="size-3.5 shrink-0" />
      <span class="truncate" data-place-name>{JAKARTA.name}</span>
      <Icon name="chevron" class="size-3.5 shrink-0 opacity-70" />
      <span class="sr-only">{s.changePlace}</span>
    </button>
  </div>

  <div class="mt-6 flex items-end justify-between gap-4">
    <div>
      <p class="text-sm text-white/70">{s.nextPrayer}</p>
      <p class="mt-1 text-3xl font-bold tracking-[-0.02em] sm:text-4xl" data-next-name>{s.prayers[next.index]}</p>
    </div>
    <p class="tnum text-3xl font-light tracking-[-0.02em] sm:text-4xl" data-next-time>{fmt(next.at)}</p>
  </div>
  <div class="mt-4 h-1.5 overflow-hidden rounded-full bg-white/15">
    <div class="h-full origin-left rounded-full bg-white transition-transform duration-700" style="transform:scaleX(0)" data-progress></div>
  </div>
  <p class="mt-2 text-sm font-medium text-white/85" data-countdown aria-live="polite">&nbsp;</p>

  <ol class="mt-5 grid grid-cols-2 gap-1 sm:grid-cols-1">
    {
      s.prayers.map((name, i) => (
        <li
          class:list={["times-row flex items-center justify-between rounded-xl px-3 py-2 text-sm", i === P.Imsak && "hidden sm:flex"]}
          data-row={i}
          data-state={state(i)}
        >
          <span>{name}</span>
          <span class="tnum font-semibold" data-time>{fmt(day.times[i]!)}</span>
        </li>
      ))
    }
  </ol>
  <p class="mt-4 text-xs text-white/60">{s.method}</p>
</section>

<PlacePicker lang={lang} />
