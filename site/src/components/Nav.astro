---
import { t, type Lang, APK_URL, REPO } from "../i18n";
import Icon from "./Icon.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const other = lang === "id" ? "/en/" : "/";
---

<header class="site-nav fixed inset-x-0 top-0 z-40 text-white" data-nav>
  <nav class="mx-auto flex h-16 max-w-6xl items-center gap-2 px-5 sm:px-8">
    <a href="#top" class="mr-auto flex items-center gap-2.5 font-bold tracking-[-0.01em]">
      <img src="/icon.svg" alt="" width="30" height="30" class="size-[30px]" />
      <span>Waktu Sholat</span>
    </a>
    <a href="#hari" class="nav-muted hidden rounded-full px-3 py-2 text-sm text-white/80 hover:text-white md:block">{s.navDay}</a>
    <a href="#fitur" class="nav-muted hidden rounded-full px-3 py-2 text-sm text-white/80 hover:text-white md:block">{s.navFeatures}</a>
    <a href={`https://github.com/${REPO}`} class="nav-muted hidden rounded-full px-3 py-2 text-sm text-white/80 hover:text-white md:block">GitHub</a>
    <a
      href={other}
      hreflang={lang === "id" ? "en" : "id"}
      lang={lang === "id" ? "en" : "id"}
      aria-label={s.langSwitchLabel}
      class="nav-ring nav-muted rounded-full border border-white/25 px-3 py-1.5 text-sm font-semibold text-white/90 hover:text-white"
    >{s.langSwitch}</a>
    <a href={APK_URL} class="nav-cta inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-semibold transition-colors" data-download>
      <Icon name="download" class="size-4" />
      <span class="hidden sm:inline">{s.navDownload}</span>
    </a>
  </nav>
</header>
