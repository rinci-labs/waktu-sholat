---
// Source of public/og-image.png (1200x630), drawn with the hero's own sky and landscape.
// Render: see README "Share image". Not linked or indexed.
import "../styles/global.css";
import Scene from "../components/Scene.astro";
import Icon from "../components/Icon.astro";
import { strings } from "../i18n";
import { fmt } from "../lib/prayer";
import { JAKARTA, dayAt } from "../lib/day";

const s = strings.id;
// A fixed afternoon so the image never changes with the build date.
const day = dayAt(JAKARTA, new Date("2026-09-26T07:30:00Z"));
const rows = [1, 3, 4, 5, 6] as const;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Waktu Sholat share image</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;700;800&display=swap" rel="stylesheet" />
    <style is:global>
      html, body { margin: 0; width: 1200px; height: 630px; overflow: hidden; }
      .cloud, .birds { display: none; }
      .sun-halo { animation: none !important; }
      .sky-body { left: 57% !important; bottom: 262px !important; }
    </style>
  </head>
  <body>
    <div class="sky relative isolate h-[630px] w-[1200px] overflow-hidden text-white" data-period="siang" style="--land:350px">
      <Scene progress={0.6} moon={false} />
      <div class="absolute top-[64px] left-[72px] w-[600px]">
        <div class="flex items-center gap-3.5 text-[26px] font-bold">
          <img src="/icon.svg" alt="" width="52" height="52" />Waktu Sholat
        </div>
        <h1 class="mt-8 text-[58px] leading-[1.04] font-extrabold tracking-[-0.035em]">{s.headline}</h1>
        <p class="mt-5 max-w-[520px] text-[23px] leading-snug font-medium text-white/85">Metode Kemenag, arah kiblat akurat, dan lima widget. Gratis tanpa iklan.</p>
      </div>
      <div class="glass absolute top-[64px] right-[72px] w-[340px] rounded-[28px] p-6">
        <div class="flex items-center justify-between">
          <span class="text-[17px] font-semibold">{s.todayTitle}</span>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-white/15 px-3 py-1 text-[14px] font-medium"><Icon name="pin" class="size-3.5" />Jakarta</span>
        </div>
        <p class="mt-5 text-[14px] text-white/70">{s.nextPrayer}</p>
        <div class="mt-1 flex items-end justify-between">
          <span class="text-[34px] font-bold tracking-[-0.02em]">{s.prayers[4]}</span>
          <span class="tnum text-[34px] font-light">{fmt(day.times[4])}</span>
        </div>
        <div class="mt-3 h-1.5 rounded-full bg-white/15"><div class="h-full w-[70%] rounded-full bg-white"></div></div>
        <ol class="mt-4 space-y-1 text-[15px]">
          {
            rows.map((i) => (
              <li class="times-row flex justify-between rounded-xl px-3 py-1.5" data-state={i === 4 ? "next" : i < 4 ? "past" : "later"}>
                <span>{s.prayers[i]}</span>
                <span class="tnum font-semibold">{fmt(day.times[i])}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </body>
</html>
