<?xml version="1.0" encoding="utf-8"?>
<!--
  Highlight behind the prayer currently in effect. Applied with `setBackgroundResource`, which passes
  a resource id rather than a resolved colour: the launcher re-resolves it against the active
  configuration, so the highlight follows the device theme instead of freezing at render time.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/brand_soft" />
    <corners android:radius="@dimen/radius_cell" />
</shape>
