<?xml version="1.0" encoding="utf-8"?>
<!--
  Highlight behind the prayer in effect. Applied with setBackgroundResource, which passes a resource
  id rather than a resolved colour, so the launcher re-resolves it on a light/dark switch.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_accent_soft" />
    <corners android:radius="12dp" />
</shape>
