<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget surface. Translucent fill plus a hairline stroke, which is the shape language Android 12+
  widgets use; the launcher draws its own shadow behind it.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_background" />
    <corners android:radius="@dimen/radius_widget" />
    <stroke
        android:width="1dp"
        android:color="@color/outline" />
</shape>
