<?xml version="1.0" encoding="utf-8"?>
<!--
  Background for the prayer currently in effect. A resource rather than a resolved colour so the
  tint follows the device theme, matching how the widget highlights its active cell.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/brand_soft" />
    <corners android:radius="@dimen/radius_cell" />
</shape>
