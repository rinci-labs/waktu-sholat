<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar icon: the launcher's crescent (ic_launcher_foreground.xml), scaled from that artwork's
  108-unit space into this 24-unit viewport by one uniform factor and centred, so the two glyphs stay
  geometrically similar rather than merely similar by eye. The launcher crescent is an outer disc
  (r=30) minus an offset disc (r=25.5, centre offset +10.75,-7); the two discs meet at the horn tips,
  which is where this path's arcs begin and end.

  One subpath of two arcs, not two circular subpaths: evenOdd across two nested discs yields their
  XOR, whose result still carries the subtracted disc's own bulge outside the outer disc, so it is
  not a crescent. A single closed outline is also self-consistently filled under either fill rule,
  which is why fillType=nonZero is safe here and no strokes, gradients or clipping are needed.

  Painted size is about 17.15 x 18.0, centred on the 24dp box with a 3-unit margin on every side:
  safely inside the box, and comfortably inside the area some status bars crop small icons to. The
  platform keeps a small icon as an alpha mask and tints it itself, hence the white fill and tint.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="@android:color/white">
    <path
        android:fillColor="@android:color/white"
        android:fillType="nonZero"
        android:pathData="M20.599,15.712 A9,9 0 1,1 12.322,3 A7.65,7.65 0 1,0 20.599,15.712 Z" />
</vector>
