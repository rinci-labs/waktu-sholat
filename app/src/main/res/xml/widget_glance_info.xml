<?xml version="1.0" encoding="utf-8"?>
<!--
  Minimalis: text straight on the wallpaper.
  minWidth/minHeight are the pre-API-31 size (4x1 cells); targetCell* say the same on API 31+.
  WidgetUpdater repaints every minute with a non-waking alarm. updatePeriodMillis (30 minutes, the
  system minimum) is only a safety net: if that alarm chain is ever lost (the process killed by a
  battery manager, an alarm dropped while idle), the system's own periodic update restarts it.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_glance_desc"
    android:initialLayout="@layout/widget_glance"
    android:minWidth="250dp"
    android:minHeight="40dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:maxResizeWidth="530dp"
    android:maxResizeHeight="530dp"
    android:previewLayout="@layout/widget_glance_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
