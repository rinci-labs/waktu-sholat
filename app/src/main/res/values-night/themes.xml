<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Dark theme: same styles, dark parent, and the light-on-dark flags flipped. Because every colour
      is an alias resolved from `values-night/colors.xml`, only the theme parent and the two
      `windowLight*` flags need to differ here.
    -->
    <style name="Theme.WaktuSholat" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
    </style>
</resources>
