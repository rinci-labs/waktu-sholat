<?xml version="1.0" encoding="utf-8"?>
<!-- Widget-picker preview for widget_times (API 31+). Static sample content, never a RemoteViews. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/widget_pad_small">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            style="@style/Widget.Text.Muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/prayer_fajr"
            android:textSize="@dimen/widget_cell_name" />

        <TextView
            style="@style/Widget.Text.Time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="04:25"
            android:textSize="@dimen/widget_cell_time"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            style="@style/Widget.Text.Muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/prayer_sunrise"
            android:textSize="@dimen/widget_cell_name" />

        <TextView
            style="@style/Widget.Text.Time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="05:37"
            android:textSize="@dimen/widget_cell_time"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            style="@style/Widget.Text.Muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/prayer_dhuhr"
            android:textSize="@dimen/widget_cell_name" />

        <TextView
            style="@style/Widget.Text.Time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="11:47"
            android:textSize="@dimen/widget_cell_time"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/widget_cell_active"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            style="@style/Widget.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/prayer_asr"
            android:textColor="@color/widget_accent"
            android:textSize="@dimen/widget_cell_name" />

        <TextView
            style="@style/Widget.Text.Time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="14:55"
            android:textColor="@color/widget_accent"
            android:textSize="@dimen/widget_cell_time"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            style="@style/Widget.Text.Muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/prayer_maghrib"
            android:textSize="@dimen/widget_cell_name" />

        <TextView
            style="@style/Widget.Text.Time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="17:51"
            android:textSize="@dimen/widget_cell_time"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            style="@style/Widget.Text.Muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/prayer_isha"
            android:textSize="@dimen/widget_cell_name" />

        <TextView
            style="@style/Widget.Text.Time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="18:59"
            android:textSize="@dimen/widget_cell_time"
            tools:ignore="HardcodedText" />
    </LinearLayout>
</LinearLayout>
