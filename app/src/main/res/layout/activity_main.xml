<?xml version="1.0" encoding="utf-8"?>
<!--
  Today's schedule.

  Layout follows the platform's own list-screen conventions: a header row, one prominent "next" block,
  then a single grouped card holding the day's times, then secondary actions. Only the next prayer and
  the active row carry the accent colour, so the eye has one place to land.

  The whole content is inset from the system bars and drawn on a scrolling surface, per the
  edge-to-edge guidance for Android 15+.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingTop="@dimen/space_16"
        android:paddingBottom="@dimen/space_32">

        <!-- Header: location and date on the left, settings affordance on the right. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/city"
                    style="@style/Text.Headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/hijri"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/refresh"
                style="@style/IconButton"
                android:layout_marginStart="@dimen/space_8"
                android:contentDescription="@string/action_refresh"
                android:src="@drawable/ic_refresh" />

            <ImageButton
                android:id="@+id/settings"
                style="@style/IconButton"
                android:contentDescription="@string/action_settings"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <!-- Next prayer: the one block that uses the accent colour and the display size. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="@dimen/space_20">

            <TextView
                android:id="@+id/next_label"
                style="@style/Text.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/next_prayer_label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/next_name"
                    style="@style/Text.Headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/next_time"
                    style="@style/Text.Display"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textColor="@color/brand" />
            </LinearLayout>

            <TextView
                android:id="@+id/countdown"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4" />

            <!-- Thin progress line showing how far into the current interval we are. -->
            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="@dimen/space_16"
                android:max="1000"
                android:progressBackgroundTint="@color/surface_alt"
                android:progressTint="@color/brand" />
        </LinearLayout>

        <TextView
            style="@style/Text.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:layout_marginBottom="@dimen/space_8"
            android:text="@string/section_today" />

        <!-- One card holds every time, so the list reads as a single group. -->
        <LinearLayout
            android:id="@+id/rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_4"
            android:paddingBottom="@dimen/space_4" />

        <TextView
            style="@style/Text.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:layout_marginBottom="@dimen/space_8"
            android:text="@string/section_qibla" />

        <!-- Qibla entry point: shows the two numbers so the card is useful before it is opened. -->
        <LinearLayout
            android:id="@+id/open_qibla"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:minHeight="@dimen/touch_target"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_16"
            android:paddingEnd="@dimen/space_16"
            android:paddingTop="@dimen/space_12"
            android:paddingBottom="@dimen/space_12">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/action_qibla"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/qibla_summary"
                    style="@style/Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2" />
            </LinearLayout>

            <TextView
                android:id="@+id/qibla_bearing"
                style="@style/Text.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:textColor="@color/brand" />
        </LinearLayout>

        <TextView
            android:id="@+id/open_month"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target"
            android:layout_marginTop="@dimen/space_8"
            android:background="@drawable/card"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/space_16"
            android:paddingEnd="@dimen/space_16"
            android:text="@string/action_open_month"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/zone_note"
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16" />
    </LinearLayout>
</ScrollView>
