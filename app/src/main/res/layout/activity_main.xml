<?xml version="1.0" encoding="utf-8"?>
<!--
  Today. Reading order: where and when (header), what is next (accent card), the whole day (list),
  then the two secondary screens as tiles. Only the accent card and the active row use the brand
  colour, so a glance lands on the next prayer first.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingTop="@dimen/space_16"
        android:paddingBottom="@dimen/space_32">

        <!-- Header: date, city (tap to change) and Hijri date; settings on the right. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="top"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/date"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:maxLines="1" />

                <LinearLayout
                    android:id="@+id/city_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-6dp"
                    android:layout_marginTop="@dimen/space_4"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="@string/action_change_city"
                    android:gravity="center_vertical"
                    android:minHeight="40dp"
                    android:orientation="horizontal"
                    android:paddingStart="6dp"
                    android:paddingEnd="4dp">

                    <TextView
                        android:id="@+id/city"
                        style="@style/Text.Headline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_4"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_expand" />
                </LinearLayout>

                <TextView
                    android:id="@+id/hijri"
                    style="@style/Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:maxLines="1" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/settings"
                style="@style/IconButton"
                android:layout_marginEnd="-12dp"
                android:contentDescription="@string/action_settings"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <!-- Next prayer. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:background="@drawable/hero_card"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_24"
            android:paddingEnd="@dimen/space_24"
            android:paddingTop="@dimen/space_20"
            android:paddingBottom="@dimen/space_20">

            <TextView
                android:id="@+id/next_label"
                style="@style/Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/next_prayer_label"
                android:textColor="@color/on_brand_muted" />

            <TextView
                android:id="@+id/next_name"
                style="@style/Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:textColor="@color/on_brand"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/next_time"
                style="@style/Text.Display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:textColor="@color/on_brand" />

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="@dimen/space_20"
                android:max="1000"
                android:progressDrawable="@drawable/hero_progress" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/current"
                    style="@style/Text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/on_brand_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/countdown"
                    style="@style/Text.Time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/on_brand"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Text.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_4"
            android:layout_marginTop="@dimen/space_24"
            android:layout_marginBottom="@dimen/space_8"
            android:text="@string/section_today" />

        <!-- Rows are inflated once per day and restyled each minute. -->
        <LinearLayout
            android:id="@+id/rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="6dp" />

        <!-- Secondary screens, each tile previewing its answer so it is useful before it is opened. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/open_qibla"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/card_pressable"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_compass" />

                <TextView
                    style="@style/Text.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:maxLines="1"
                    android:text="@string/qibla_title" />

                <TextView
                    android:id="@+id/qibla_summary"
                    style="@style/Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:maxLines="1" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/open_month"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/card_pressable"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_calendar" />

                <TextView
                    style="@style/Text.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:maxLines="1"
                    android:text="@string/section_month" />

                <TextView
                    android:id="@+id/month_summary"
                    style="@style/Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/zone_note"
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:gravity="center" />
    </LinearLayout>
</ScrollView>
