<?xml version="1.0" encoding="utf-8"?>
<!-- Widget-picker preview for widget_schedule (API 31+). Static sample content. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="@dimen/widget_pad_small"
    android:paddingEnd="@dimen/widget_pad_small"
    android:paddingTop="@dimen/widget_pad"
    android:paddingBottom="@dimen/widget_pad_small">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Widget.Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sample_city" />

            <TextView
                style="@style/Widget.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/prayer_maghrib"
                android:textSize="@dimen/widget_name" />
        </LinearLayout>

        <TextView
            style="@style/Widget.Text.Hero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="17:51"
            android:textSize="@dimen/widget_hero_small"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_8"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <TextView
                style="@style/Widget.Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/prayer_fajr"
                android:textSize="@dimen/widget_row_time" />

            <TextView
                style="@style/Widget.Text.Time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="04:25"
                android:textSize="@dimen/widget_row_time"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <TextView
                style="@style/Widget.Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/prayer_sunrise"
                android:textSize="@dimen/widget_row_time" />

            <TextView
                style="@style/Widget.Text.Time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="05:37"
                android:textSize="@dimen/widget_row_time"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <TextView
                style="@style/Widget.Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/prayer_dhuhr"
                android:textSize="@dimen/widget_row_time" />

            <TextView
                style="@style/Widget.Text.Time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="11:47"
                android:textSize="@dimen/widget_row_time"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/widget_cell_active"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <TextView
                style="@style/Widget.Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/prayer_asr"
                android:textColor="@color/widget_accent"
                android:textSize="@dimen/widget_row_time" />

            <TextView
                style="@style/Widget.Text.Time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14:55"
                android:textColor="@color/widget_accent"
                android:textSize="@dimen/widget_row_time"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <TextView
                style="@style/Widget.Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/prayer_maghrib"
                android:textSize="@dimen/widget_row_time" />

            <TextView
                style="@style/Widget.Text.Time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="17:51"
                android:textSize="@dimen/widget_row_time"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <TextView
                style="@style/Widget.Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/prayer_isha"
                android:textSize="@dimen/widget_row_time" />

            <TextView
                style="@style/Widget.Text.Time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18:59"
                android:textSize="@dimen/widget_row_time"
                tools:ignore="HardcodedText" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
