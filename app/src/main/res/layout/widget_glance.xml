<?xml version="1.0" encoding="utf-8"?>
<!--
  "Minimalis": no background, just text on the wallpaper with a soft shadow, in the style of the
  stock At-a-Glance line. The second line says how long until the next prayer.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical|start"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_12"
    android:paddingEnd="@dimen/space_12">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_next_time"
            style="@style/Glance.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:text="@string/sample_time"
            android:textSize="@dimen/widget_glance" />

        <TextView
            android:id="@+id/widget_next_name"
            style="@style/Glance.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:fontFamily="sans-serif-medium"
            android:text="@string/prayer_asr"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_relative"
            style="@style/Glance.Text"
            android:text="@string/sample_remaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/glance_text_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_location"
            style="@style/Glance.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sample_city_suffix"
            android:textColor="@color/glance_text_muted"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
