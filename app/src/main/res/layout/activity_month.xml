<?xml version="1.0" encoding="utf-8"?>
<!--
  Monthly table: a month stepper, then the days. The first row of the injected table is its own
  column header, so the columns stay identified as the list scrolls under the stepper.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Month stepper: two icon buttons with the month between them. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_8"
        android:paddingEnd="@dimen/space_8"
        android:paddingTop="@dimen/space_8">

        <ImageButton
            android:id="@+id/prev"
            style="@style/IconButton"
            android:contentDescription="@string/month_prev"
            android:src="@drawable/ic_chevron_left" />

        <TextView
            android:id="@+id/month_title"
            style="@style/Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="1" />

        <ImageButton
            android:id="@+id/next"
            style="@style/IconButton"
            android:contentDescription="@string/month_next"
            android:src="@drawable/ic_chevron_right" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_16"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/table"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_8"
            android:paddingEnd="@dimen/space_8" />
    </ScrollView>
</LinearLayout>
