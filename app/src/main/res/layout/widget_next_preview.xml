<?xml version="1.0" encoding="utf-8"?>
<!-- Widget-picker preview for widget_next: a TextView stands in for the Chronometer, which would show 00:00. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="@dimen/widget_pad">

    <TextView
        style="@style/Widget.Text.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_8"
        android:text="@string/next_prayer_label" />

    <TextView
        style="@style/Widget.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="@string/prayer_asr"
        android:textSize="@dimen/widget_name" />

    <TextView
        style="@style/Widget.Text.Hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/sample_time"
        android:textSize="@dimen/widget_hero" />

    <TextView
        style="@style/Widget.Text.Muted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFeatureSettings="tnum"
        android:text="@string/sample_countdown"
        android:textSize="@dimen/widget_body" />

    <TextView
        style="@style/Widget.Text.Muted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:text="@string/sample_city"
        android:textSize="@dimen/widget_label" />
</LinearLayout>
