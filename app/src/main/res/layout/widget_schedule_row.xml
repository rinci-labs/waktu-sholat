<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the vertical schedule; rows share the list height equally. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:minHeight="24dp"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="6dp">

    <TextView
        android:id="@+id/cell_name"
        style="@style/Widget.Text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="@dimen/widget_row_time" />

    <TextView
        android:id="@+id/cell_time"
        style="@style/Widget.Text.Time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/widget_row_time" />
</LinearLayout>
