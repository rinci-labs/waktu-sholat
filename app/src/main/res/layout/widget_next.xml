<?xml version="1.0" encoding="utf-8"?>
<!--
  "Sholat berikutnya": the next prayer, large, and how long until it ("7 jam 33 mnt lagi"),
  refreshed each minute. On a short cell the label and location lines are hidden.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="@dimen/widget_pad">

    <TextView
        android:id="@+id/widget_label"
        style="@style/Widget.Text.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_8"
        android:text="@string/next_prayer_label" />

    <TextView
        android:id="@+id/widget_next_name"
        style="@style/Widget.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="@string/prayer_asr"
        android:textSize="@dimen/widget_name" />

    <TextView
        android:id="@+id/widget_next_time"
        style="@style/Widget.Text.Hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/sample_time"
        android:textSize="@dimen/widget_hero" />

    <TextView
        android:id="@+id/widget_relative"
        style="@style/Widget.Text"
        android:fontFamily="sans-serif-medium"
        android:text="@string/sample_remaining"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFeatureSettings="tnum"
        android:textSize="@dimen/widget_body" />

    <TextView
        android:id="@+id/widget_location"
        style="@style/Widget.Text.Muted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:text="@string/sample_city"
        android:textSize="@dimen/widget_label" />
</LinearLayout>
