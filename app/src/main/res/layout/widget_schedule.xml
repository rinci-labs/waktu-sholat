<?xml version="1.0" encoding="utf-8"?>
<!--
  "Jadwal lengkap": location and next prayer on top, then the whole day as a vertical list with the
  active prayer highlighted. The next-prayer block hides itself when the cell is too short.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/widget_pad_small"
    android:paddingEnd="@dimen/widget_pad_small"
    android:paddingTop="@dimen/widget_pad"
    android:paddingBottom="@dimen/widget_pad_small">

    <LinearLayout
        android:id="@+id/widget_hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_location"
                style="@style/Widget.Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sample_city" />

            <TextView
                android:id="@+id/widget_next_name"
                style="@style/Widget.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/prayer_asr"
                android:textSize="@dimen/widget_name" />

            <TextView
                android:id="@+id/widget_relative"
                style="@style/Widget.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/sample_remaining"
                android:textColor="@color/widget_accent"
                android:textSize="@dimen/widget_body" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_next_time"
            style="@style/Widget.Text.Hero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:text="@string/sample_time"
            android:textSize="@dimen/widget_hero_small" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_rows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_8"
        android:layout_weight="1"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/widget_hijri"
        style="@style/Widget.Text.Muted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textSize="@dimen/widget_label" />
</LinearLayout>
