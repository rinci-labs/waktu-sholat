<?xml version="1.0" encoding="utf-8"?>
<!--
  One timetable row: weekday initial, date, then six prayer columns with equal weight. The header
  row inflates this same file, so the columns line up exactly.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="36dp"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <TextView style="@style/MonthCell.Lead" android:layout_width="22dp" />
    <TextView style="@style/MonthCell.Lead" android:layout_width="24dp" android:textSize="13sp" />
    <TextView style="@style/MonthCell" />
    <TextView style="@style/MonthCell" />
    <TextView style="@style/MonthCell" />
    <TextView style="@style/MonthCell" />
    <TextView style="@style/MonthCell" />
    <TextView style="@style/MonthCell" />
</LinearLayout>
