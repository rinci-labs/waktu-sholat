<?xml version="1.0" encoding="utf-8"?>
<!--
  "Jadwal hari ini": the day's times as one horizontal band. At one cell tall only the band fits;
  from two cells the location/Hijri header appears above it. Cells are injected by the renderer.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="@dimen/widget_pad_small"
    android:paddingEnd="@dimen/widget_pad_small"
    android:paddingTop="@dimen/widget_pad_small"
    android:paddingBottom="@dimen/widget_pad_small">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_8"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_location"
            style="@style/Widget.Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:textSize="@dimen/widget_body" />

        <TextView
            android:id="@+id/widget_hijri"
            style="@style/Widget.Text.Muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:textSize="@dimen/widget_body" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_cells"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal" />
</LinearLayout>
