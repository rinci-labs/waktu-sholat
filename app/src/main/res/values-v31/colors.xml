<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: widgets follow the wallpaper-derived system palette (Material You), which is what
  every stock widget on the home screen does. The app itself keeps its brand colours.
-->
<resources>
    <color name="widget_bg">@android:color/system_neutral1_50</color>
    <color name="widget_text">@android:color/system_neutral1_900</color>
    <color name="widget_text_muted">@android:color/system_neutral2_600</color>
    <color name="widget_accent">@android:color/system_accent1_600</color>
    <color name="widget_accent_soft">@android:color/system_accent1_100</color>
    <color name="widget_on_accent">@android:color/system_accent1_0</color>
    <color name="widget_on_accent_muted">@android:color/system_accent1_100</color>
</resources>
