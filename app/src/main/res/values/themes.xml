<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Light theme. `Theme.Material.Light.NoActionBar` is the framework baseline available from
      API 24; the dark palette lives in `values-night/themes.xml` with the matching `Theme.Material`
      parent, so the device's dark-mode setting flips the whole app with no code involved.

      Layouts read `?android:attr/...` wherever a framework attribute exists, which keeps them
      theme-agnostic; the app's own colour names are used only where the framework has no equivalent.
    -->
    <style name="Theme.WaktuSholat" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>

        <!-- Edge-to-edge: the content is inset by the layouts, so the bars stay transparent. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">true</item>

        <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
    </style>

    <!--
      Type styles. Sizes come from `dimens.xml` so the scale has one definition. `fontFamily` uses
      the platform families rather than a bundled font, which keeps the APK free of font assets.
    -->
    <style name="Text.Display" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="Text.Headline" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Text.Title" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.Body" parent="">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="Text.Caption" parent="">
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">@dimen/text_caption</item>
    </style>

    <!-- Uppercase section header above a card, as used by the platform's own list headings. -->
    <style name="Text.Section" parent="">
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Tabular-figure time, so the digits line up column-wise and do not shift as they tick. -->
    <style name="Text.Time" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="Text.Widget.Name" parent="">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.Widget.Time" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <!-- A borderless icon button with the platform's touch ripple and minimum 48dp target. -->
    <style name="IconButton" parent="">
        <item name="android:layout_width">@dimen/touch_target</item>
        <item name="android:layout_height">@dimen/touch_target</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:gravity">center</item>
        <item name="android:scaleType">center</item>
        <item name="android:padding">@dimen/space_12</item>
    </style>
</resources>
